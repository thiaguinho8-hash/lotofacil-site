# URL pública do site (usada em metadata, sitemap e schema.org).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link de afiliado do botão "Fazer minha aposta". Deixe vazio para esconder o botão.
NEXT_PUBLIC_AFFILIATE_URL=

# Protege a rota /api/cron para que só a Vercel (ou você) possa disparar a
# atualização. Sem essa variável, a rota funciona em desenvolvimento local mas
# fica bloqueada (401) em produção — defina-a antes de publicar o site.
CRON_SECRET=

# Armazenamento de assinantes (e-mail/WhatsApp). Sem isso, cai no fallback
# local em data/subscribers.json (não persistente em produção serverless).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Envio de notificação por e-mail quando sai resultado novo (opcional).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
